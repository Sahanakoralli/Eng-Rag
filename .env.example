# Copy this file to .env and fill in your key. Never commit .env.

# Which LLM answers questions: "openai", "anthropic", "gemini" or "nvidia"
LLM_PROVIDER=openai
# Leave blank for a sensible default (openai: gpt-4o-mini, gemini: gemini-3.8-flash, nvidia: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning).
# Check the exact model name available to your key if you get a "model not found" error.
LLM_MODEL=

# Only the key for your chosen provider is required
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
# NVIDIA reasoning models: 1 = let the model think first (slower, uses more tokens), 0 = answer directly
NVIDIA_THINKING=0

# Figure captioning (ingest --images). Must be a vision-capable model. Blank = use LLM_MODEL.
VISION_MODEL=
MAX_IMAGES_PER_DOC=25

# Local models (free, run on your CPU, no API key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Storage
QDRANT_PATH=./data/qdrant
COLLECTION_NAME=eng_docs

# Chunking
CHUNK_SIZE=600
CHUNK_OVERLAP=80

# Web app / API (python -m engrag.cli serve)
# If set, every API call (except the page and /health) must send the header  X-API-Key: <value>
API_KEY=
MAX_UPLOAD_MB=50
# 1 = run OCR on uploaded PDFs (handles scans, slower). 0 = faster, fine for PDFs that already contain text.
UPLOAD_OCR=1
